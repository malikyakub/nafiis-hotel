# Copy to .env.local and fill in. Never commit real values.
# Production and preview values live in Vercel project settings (set by M.K).

# --- Public (safe in the browser, limited by RLS) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only (never prefix with NEXT_PUBLIC_) ---
# Admin flows: create staff, approve payments, anchor records
SUPABASE_SERVICE_ROLE_KEY=
# Polygon Amoy RPC endpoint (Alchemy or similar)
AMOY_RPC_URL=
# Signs anchor transactions. Set by M.K only, never shared with agents
SYSTEM_WALLET_PRIVATE_KEY=
# Deployed ProofRegistry contract address
PROOF_REGISTRY_ADDRESS=
# AES-256-GCM key for ID document numbers
IDENTITY_ENCRYPTION_KEY=
