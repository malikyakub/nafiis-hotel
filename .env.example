# Copy to .env.local and fill in. Never commit real values.
# Production and preview values belong in the selected host's secret settings.

# --- Public (safe in the browser, limited by RLS) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Exact public HTTPS origin, e.g. https://your-hotel.example (required in production)
# Set only in the production host, preserving its canonical URL convention.
# Keep this blank for local development so loopback redirects/uploads still work.
SITE_URL=

# --- Server only (never prefix with NEXT_PUBLIC_) ---
# Admin flows: create staff, approve payments, anchor records
SUPABASE_SERVICE_ROLE_KEY=
# Preferred modern server-only key; either this or the legacy service-role key.
SUPABASE_SECRET_KEY=
# Polygon Amoy RPC endpoint (Alchemy or similar)
AMOY_RPC_URL=
# Dedicated Amoy test wallet; owner enters locally, never shares in chat
SYSTEM_WALLET_PRIVATE_KEY=
# BookingProofRegistry deployed by npm run chain:deploy; see docs/BLOCKCHAIN.md
PROOF_REGISTRY_ADDRESS=
# Reserved for the unimplemented ID-document feature; not required by current code.
IDENTITY_ENCRYPTION_KEY=

# Customer AI chat: n8n Chat Trigger production URL (Embedded Chat mode).
# Local development may use http://localhost:5678/webhook/.../chat.
# Production requires an HTTPS n8n endpoint reachable from the website server.
HOTEL_CHAT_WEBHOOK_URL=
# Random server-only signing secret, at least 32 characters; shared by all instances.
HOTEL_CHAT_SESSION_SECRET=
# Optional matching n8n Basic Auth username:password, stored only in host secrets.
HOTEL_CHAT_BASIC_AUTH=
