  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check:local": "node contracts/scripts/check-upload-limit.mjs && node contracts/scripts/check-request-security.mjs && node contracts/scripts/check-payment-review.mjs && node contracts/scripts/check-staff-forms.mjs",
